// virtualis-terminal/.env.example

# Vector API Configuration
VECTOR_API_URL=http://localhost:8000

# Local SQLite database for chat/session state
DATABASE_URL=file:./prisma/dev.db

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_BOOT_MODEL=claude-haiku-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5

# Optional Anthropic call tuning
# ANTHROPIC_CHAT_MAX_TOKENS=2048
# ANTHROPIC_CHAT_TEMPERATURE=1
# ANTHROPIC_BOOT_MAX_TOKENS=1024
# ANTHROPIC_BOOT_TEMPERATURE=0.7
# ANTHROPIC_HAIKU_MAX_TOKENS=256
# ANTHROPIC_HAIKU_TEMPERATURE=0.9

# Optional: Override default port for Next.js
# PORT=3000
