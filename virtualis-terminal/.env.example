// virtualis-terminal/.env.example

# Postgres (Neon or any pgvector-enabled instance).
# Carries both chat/session state (Prisma) and the published vector corpus.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: point vector queries at a different database than threads
# VECTOR_DATABASE_URL=

# Voyage AI (must match the model the corpus was published with)
VOYAGE_API_KEY=pa-xxxx
VOYAGE_MODEL=voyage-3

# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_BOOT_MODEL=claude-haiku-4-5
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5

# Optional Anthropic call tuning
# ANTHROPIC_CHAT_MAX_TOKENS=2048
# ANTHROPIC_CHAT_TEMPERATURE=1
# ANTHROPIC_BOOT_MAX_TOKENS=1024
# ANTHROPIC_BOOT_TEMPERATURE=0.7
# ANTHROPIC_HAIKU_MAX_TOKENS=256
# ANTHROPIC_HAIKU_TEMPERATURE=0.9

# Optional: Override default port for Next.js
# PORT=3000

# Production housekeeping (Vercel)
# Secret for the scheduled cleanup endpoint (/api/cron/cleanup)
CRON_SECRET=generate-a-long-random-string

# Self-repo tools: 'git' (local checkout) or 'github' (public API; the
# default on Vercel, where no .git directory exists in the bundle)
# SELF_REPO_SOURCE=github
# Optional token raises GitHub API rate limits for the self-repo tools
# GITHUB_TOKEN=
