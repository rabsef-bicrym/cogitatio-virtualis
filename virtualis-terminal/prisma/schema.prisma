generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Session {
  id           String          @id @default(uuid())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  expiresAt    DateTime
  data         Json?
  isActive     Boolean         @default(true)
  lastActivity DateTime        @default(now())
  messages     ThreadMessage[]

  @@index([expiresAt])
  @@index([isActive, lastActivity])
  @@index([createdAt])
}

model ThreadMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  timestamp DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

// The published vector corpus. Written by cogitatio-server's
// scripts/publish_index.py and read by lib/api/vector.ts; declared here so
// `prisma db push` preserves it instead of treating it as an unknown table.
model VectorChunk {
  vectorId  Int                         @id @map("vector_id")
  docId     String                      @map("doc_id")
  chunkId   String                      @map("chunk_id")
  content   String
  metadata  Json
  embedding Unsupported("vector(1024)")

  @@index([docId])
  @@map("vector_chunks")
}
