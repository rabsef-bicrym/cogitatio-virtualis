{
  "name": "virtualis-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "prebuild:ts": "prisma generate",
    "build:ts": "tsc",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "test:unit": "vitest run",
    "pretest:e2e": "prisma generate",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "check": "npm run format && npm run lint && npm run build:ts -- --noEmit && npm run test:unit && npm run test:e2e && npm run build",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.92.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "crt-terminal": "1.1.3",
    "dotenv": "^17.4.2",
    "next": "16.2.4",
    "pg": "^8.21.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "typescript": "6.0.3",
    "vitest": "^4.0.15"
  }
}
